#[test_only]
module {{named_address}}::{{module_name}}_tests {
    use {{named_address}}::{{module_name}};
    use std::vector;

    fun proof_a_bytes(): vector<u8> { {{{proof_a}}} }
    fun proof_b_bytes(): vector<u8> { {{{proof_b}}} }
    fun proof_c_bytes(): vector<u8> { {{{proof_c}}} }
    fun public_inputs_bytes(): vector<vector<u8>> { {{{public_inputs_rendered}}} }
    fun invalid_public_inputs_bytes(): vector<vector<u8>> { {{{invalid_public_inputs_rendered}}} }
    {{#if has_public_inputs}}
    fun noncanonical_public_inputs_bytes(): vector<vector<u8>> { {{{noncanonical_public_inputs_rendered}}} }
    fun modulus_plus_one_public_inputs_bytes(): vector<vector<u8>> { {{{modulus_plus_one_public_inputs_rendered}}} }
    fun short_public_inputs_bytes(): vector<vector<u8>> { {{{short_public_inputs_rendered}}} }
    fun long_public_inputs_bytes(): vector<vector<u8>> { {{{long_public_inputs_rendered}}} }
    {{/if}}

    #[test]
    fun test_valid_proof() {
        let ok = {{module_name}}::verify(
            public_inputs_bytes(),
            proof_a_bytes(),
            proof_b_bytes(),
            proof_c_bytes(),
        );
        assert!(ok, 1);
    }

    #[test]
    fun test_invalid_proof_fails() {
        let ok = {{module_name}}::verify(
            public_inputs_bytes(),
            proof_c_bytes(),
            proof_b_bytes(),
            proof_a_bytes(),
        );
        assert!(!ok, 1);
    }

    #[test]
    fun test_invalid_public_input_fails() {
        let public_inputs = public_inputs_bytes();
        if (vector::is_empty(&public_inputs)) {
            let proof_a = proof_a_bytes();
            if (!vector::is_empty(&proof_a)) {
                let first = *vector::borrow(&proof_a, 0);
                vector::pop_back(&mut proof_a);
                vector::push_back(&mut proof_a, first + 1);
            };
            let empty_public_inputs: vector<vector<u8>> = vector[];
            let ok = {{module_name}}::verify(
                empty_public_inputs,
                proof_a,
                proof_b_bytes(),
                proof_c_bytes(),
            );
            assert!(!ok, 1);
        } else {
            let ok = {{module_name}}::verify(
                invalid_public_inputs_bytes(),
                proof_a_bytes(),
                proof_b_bytes(),
                proof_c_bytes(),
            );
            assert!(!ok, 1);
        };
    }

    {{#if has_public_inputs}}
    #[test]
    #[expected_failure(abort_code = 1, location = {{named_address}}::{{module_name}})]
    fun test_scalar_modulus_is_rejected() {
        {{module_name}}::verify(
            noncanonical_public_inputs_bytes(),
            proof_a_bytes(),
            proof_b_bytes(),
            proof_c_bytes(),
        );
    }

    #[test]
    #[expected_failure(abort_code = 1, location = {{named_address}}::{{module_name}})]
    fun test_scalar_modulus_plus_one_is_rejected() {
        {{module_name}}::verify(
            modulus_plus_one_public_inputs_bytes(),
            proof_a_bytes(),
            proof_b_bytes(),
            proof_c_bytes(),
        );
    }

    #[test]
    #[expected_failure(abort_code = 1, location = {{named_address}}::{{module_name}})]
    fun test_short_scalar_is_rejected() {
        {{module_name}}::verify(
            short_public_inputs_bytes(),
            proof_a_bytes(),
            proof_b_bytes(),
            proof_c_bytes(),
        );
    }

    #[test]
    #[expected_failure(abort_code = 1, location = {{named_address}}::{{module_name}})]
    fun test_long_scalar_is_rejected() {
        {{module_name}}::verify(
            long_public_inputs_bytes(),
            proof_a_bytes(),
            proof_b_bytes(),
            proof_c_bytes(),
        );
    }
    {{/if}}
}
